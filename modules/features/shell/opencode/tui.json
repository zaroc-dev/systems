{
  "cli": {
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": { "name": "lucent-tokyonight", "mode": "dark" },
    "animations": true,
    "terminal": { "title": true }
  },
  "themes": {
    "blur": {
      "base": {
        "text": { "base": "#e2e8f0", "muted": "#94a3b8" },
        "background": {
          "base": "transparent",
          "raised": {
            "base": "transparent",
            "high": "transparent",
            "max": "transparent"
          }
        },
        "border": { "base": "#334155" }
      }
    },
    "lucent-tokyonight": {
      "$schema": "https://opencode.ai/theme.json",
      "base": {
        "categorical": ["blue", "purple", "cyan", "green", "orange", "red"],
        "text": {
          "base": "#c0caf5",
          "muted": "#9aa5ce",
          "action": {
            "primary": {
              "base": "$text.base",
              "$disabled": "$text.muted",
              "$focused": "#1a1b26",
              "$selected": "#7aa2f7"
            },
            "secondary": { "base": "$text.muted", "$hovered": "$text.base" },
            "destructive": { "base": "#f7768e", "$disabled": "$text.muted" }
          },
          "formfield": {
            "base": "$text.base",
            "$hovered": "#7aa2f7",
            "$focused": "#7aa2f7",
            "$pressed": "#7aa2f7",
            "$selected": "#7aa2f7",
            "$disabled": "$text.muted"
          },
          "feedback": {
            "error": { "base": "#f7768e" },
            "warning": { "base": "#e0af68" },
            "success": { "base": "#9ece6a" },
            "info": { "base": "#7dcfff" }
          }
        },
        "background": {
          "base": "transparent",
          "raised": {
            "base": "transparent",
            "high": "transparent",
            "max": "transparent"
          },
          "action": {
            "primary": {
              "base": "transparent",
              "$hovered": "#292e4299",
              "$focused": "#7aa2f7",
              "$selected": "transparent"
            },
            "secondary": { "base": "transparent" },
            "destructive": { "base": "#f7768e" }
          },
          "formfield": { "base": "$background.base" },
          "feedback": {
            "error": { "base": "$background.base" },
            "warning": { "base": "$background.base" },
            "success": { "base": "$background.base" },
            "info": { "base": "$background.base" }
          }
        },
        "border": { "base": "#7aa2f7" },
        "scrollbar": { "base": "#bb9af7" },
        "diff": {
          "text": {
            "added": "#9ece6a",
            "removed": "#f7768e",
            "context": "#9aa5ce",
            "hunkHeader": "#bb9af7"
          },
          "background": {
            "added": "transparent",
            "removed": "transparent",
            "context": "transparent"
          },
          "highlight": { "added": "#73daca", "removed": "#f7768e" },
          "lineNumber": {
            "text": "#565f89",
            "background": { "added": "transparent", "removed": "transparent" }
          }
        },
        "syntax": {
          "comment": "#565f89",
          "keyword": "#bb9af7",
          "function": "#7aa2f7",
          "variable": "#c0caf5",
          "string": "#9ece6a",
          "number": "#ff9e64",
          "type": "#2ac3de",
          "operator": "#89ddff",
          "punctuation": "#9abdf5"
        },
        "markdown": {
          "text": "#c0caf5",
          "heading": "#7aa2f7",
          "link": "#7aa2f7",
          "linkText": "#7dcfff",
          "code": "#9ece6a",
          "blockQuote": "#bb9af7",
          "emphasis": "#e0af68",
          "strong": "#bb9af7",
          "horizontalRule": "#414868",
          "listItem": "#7aa2f7",
          "listEnumeration": "#7dcfff",
          "image": "#7aa2f7",
          "imageText": "#7dcfff",
          "codeBlock": "#c0caf5"
        },
        "@dialog": {
          "background": {
            "base": "#1a1b2699",
            "raised": {
              "base": "#1f233599",
              "high": "#292e42cc",
              "max": "#3b4261cc"
            },
            "action": { "primary": { "$hovered": "#292e42cc" } }
          }
        }
      },
      "dark": {
        "hue": {
          "gray": {
            "100": "#d5dfff",
            "200": "#c0caf5",
            "300": "#a9b1d6",
            "400": "#9aa5ce",
            "500": "#565f89",
            "600": "#414868",
            "700": "#24283b",
            "800": "#1a1b26",
            "900": "#16161e"
          },
          "red": {
            "100": "#ffb6c4",
            "200": "#f7768e",
            "300": "#e66b83",
            "400": "#cd5c74",
            "500": "#a54860",
            "600": "#7e384e",
            "700": "#572b3e",
            "800": "#352333",
            "900": "#211b27"
          },
          "orange": {
            "100": "#ffcca8",
            "200": "#ff9e64",
            "300": "#e68b58",
            "400": "#c7784e",
            "500": "#a16243",
            "600": "#7b4c37",
            "700": "#56392e",
            "800": "#36282a",
            "900": "#211d25"
          },
          "yellow": {
            "100": "#f8d9a6",
            "200": "#e0af68",
            "300": "#c89b5e",
            "400": "#ac8552",
            "500": "#8c6c45",
            "600": "#6c5439",
            "700": "#4d3e2e",
            "800": "#322c27",
            "900": "#201f23"
          },
          "green": {
            "100": "#c5e8a3",
            "200": "#9ece6a",
            "300": "#89b65d",
            "400": "#759c51",
            "500": "#608045",
            "600": "#4c6339",
            "700": "#39492f",
            "800": "#283127",
            "900": "#1c2223"
          },
          "cyan": {
            "100": "#b4e5ff",
            "200": "#7dcfff",
            "300": "#6ab7df",
            "400": "#5a9dbf",
            "500": "#49809d",
            "600": "#3b647c",
            "700": "#2d4a5b",
            "800": "#22313e",
            "900": "#1a222d"
          },
          "blue": {
            "100": "#b4caff",
            "200": "#7aa2f7",
            "300": "#6b8fdf",
            "400": "#5b7bc1",
            "500": "#4c659e",
            "600": "#3d507c",
            "700": "#2f3c5c",
            "800": "#242a40",
            "900": "#1b1e2d"
          },
          "purple": {
            "100": "#ddc7ff",
            "200": "#bb9af7",
            "300": "#a487df",
            "400": "#8e73c0",
            "500": "#745e9e",
            "600": "#5b4a7b",
            "700": "#43385b",
            "800": "#2e283f",
            "900": "#201d2c"
          },
          "accent": "$hue.blue",
          "interactive": "$hue.blue",
          "neutral": "$hue.gray"
        }
      }
    }
  }
}
